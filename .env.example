# LLM: Neon AI Gateway (branch-scoped). No ANTHROPIC_API_KEY.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
MODEL_SMART=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# Neon Postgres: pooled URL for the app, direct URL for drizzle-kit
DATABASE_URL=
DATABASE_URL_DIRECT=

# Retrieval (Moss, one shared index "undercurrent")
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Email (AgentMail)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Tools (missing keys fall back to fixtures)
EXA_API_KEY=                      # web search (preferred)
TAVILY_API_KEY=                   # optional fallback
GITHUB_TOKEN=
HUNTER_API_KEY=

# Demo safety
DEMO_SAFE_MODE=true
SEND_ALLOWLIST=
STANDIN_NAME=

# Runtime
REPLAY_MODE=off
FOLLOWUP_DELAY_MINUTES=3
SWARM_PERSONAS_PER_SEGMENT=3
SWARM_MAX_CONCURRENCY=12

# Helm agent surfaces (docs/AGENTS-AND-MCP.md)
APP_URL=                          # public base URL, e.g. https://undercurrent.fly.dev
MCP_TOKENS=                       # meta MCP server auth: name:token,name2:token2
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=          # 1-256 chars [A-Za-z0-9_-]
TELEGRAM_ALLOWED_USER_IDS=        # comma-separated numeric Telegram user ids
TELEGRAM_MODE=webhook             # or "poll" for local dev
